{
  "name": "@agentrq/acp-gateway",
  "version": "0.4.1",
  "description": "ACP v1 bridge CLI for agentrq workspaces",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "acp-gateway": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentrq/acp-gateway"
  },
  "keywords": [
    "acp",
    "gateway",
    "bridge",
    "agentrq"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
